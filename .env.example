# Copia este archivo a .env.omniroute (no se sube a git) o corre: npm run omniroute:configurar
# URL pública del servicio OmniRoute en Railway, SIN /v1 y sin barra final
OMNIROUTE_URL=https://tu-omniroute.up.railway.app
# API key creada en el dashboard de OmniRoute (API Keys). Nunca la subas a git.
OMNIROUTE_API_KEY=
# Combo que usará Claude Code (créalo en el dashboard; ver docs/OMNIROUTE.md)
OMNIROUTE_MODELO_CLAUDE=bsam-claude-code
# Combo que usará el cotizador para listas de materiales y resúmenes
OMNIROUTE_MODELO_COTIZADOR=bsam-estimados
# Qué hacer si OmniRoute no responde al abrir Claude Code: abortar | directo
OMNIROUTE_FALLBACK=abortar
